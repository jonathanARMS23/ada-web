NODE_ENV=production
PORT=3002

# ═══════════════════════════════════════════════════════════════════════════════
#  Téléchargement gaté par code à usage unique
# ═══════════════════════════════════════════════════════════════════════════════

# Clé d'authentification des endpoints INTERNES :
#   POST /api/internal/codes/seed   — génère le pool de 100 000 codes
#   POST /api/internal/codes/issue  — réserve 1 code (unused → issued)
# Header attendu par ces routes : `x-internal-key: <valeur>`
#
# ⚠️  NE JAMAIS committer de vraie valeur ici. À définir dans les variables
#     d'environnement Coolify uniquement.
# ⚠️  Si cette variable est absente ou vide, les endpoints internes refusent
#     TOUTES les requêtes (fail-closed). Les endpoints publics (redeem/file)
#     ne dépendent pas de cette clé et continuent de fonctionner.
#
# Générer une valeur forte : openssl rand -hex 32
INTERNAL_API_KEY=changeme-generate-a-strong-random-value

# Base SQLite du pool de codes.
# DOIT pointer vers un volume persistant, sinon le pool est perdu à chaque
# redéploiement. Défaut si absente : <cwd>/data/codes.db
CODES_DB_PATH=/app/data/codes.db

# Archive servie par GET /api/download/file.
# DOIT rester hors de public/ (sinon le fichier redevient téléchargeable sans code).
# Défaut si absente : <cwd>/private-assets/ADA-v7.zip
DOWNLOAD_FILE_PATH=/app/private-assets/ADA-v7.zip

# Durée de vie (secondes) du jeton de téléchargement émis après validation
# d'un code. Le jeton est à usage unique. Défaut si absente : 60
DOWNLOAD_TOKEN_TTL_SECONDS=60
